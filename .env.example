# ---------------------------------------------------------------------------
# LearningForge environment
# Copy to .env and fill in. Everything marked (optional) has a local/mock
# default so the app runs end-to-end with zero external services:
#   docker compose up -d db redis   &&   npm run db:setup && npm run db:seed
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
APP_URL="http://localhost:3000"
# Port 5433 on the host (container publishes 5433:5432) so a native/WSL
# Postgres already listening on 127.0.0.1:5432 cannot shadow the container.
DATABASE_URL="postgresql://lectureforge:lectureforge@localhost:5433/lectureforge?schema=public"

# Auth.js — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-development-secret"
NEXTAUTH_URL="http://localhost:3000"

# Site-wide access key (invite-only site). When set, every page and API needs a
# cookie obtained by entering this key once at /access; changing it locks
# everyone out until they enter the new key. Leave empty to disable the gate.
# At least 12 characters in production, e.g.: openssl rand -base64 18
LECTURE_ACCESS_KEY=""

# --- Background jobs ---------------------------------------------------------
# redis | inline  (inline runs job processors in the web process — dev/tests only)
QUEUE_DRIVER="inline"
REDIS_URL="redis://localhost:6379"

# --- Storage -----------------------------------------------------------------
# local | s3   (local writes to ./.data/storage — dev/tests only)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="lectureforge"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Signed URL lifetime for media streaming (seconds)
SIGNED_URL_TTL="3600"

# --- AI provider layer --------------------------------------------------------
# mock | openai | anthropic | local | gemini | zai   (mock = deterministic offline generator)
# Default: Gemini (GEMINI_MODEL below). Administrators can switch between Gemini,
# GLM (Z.ai) and local Gemma at /admin. Without GEMINI_API_KEY, "gemini" falls back to local.
AI_PROVIDER="gemini"
AI_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
# local = any Ollama-style /api/chat JSON endpoint (e.g. gemma4:latest, llama3.1)
LOCAL_AI_BASE_URL="http://localhost:11434"
LOCAL_AI_MODEL="llama3.1"
# Reasoning models (Gemma 4, Qwen 3…) think by default — slow for structured output
LOCAL_AI_THINK="false"
LOCAL_AI_TIMEOUT_MS="300000"
LOCAL_AI_MAX_TOKENS="4096"
# Optional context-window override (tokens); unset lets Ollama decide
# LOCAL_AI_NUM_CTX="16384"

# gemini = Google Gemini API (cloud: prompts incl. source excerpts go to Google).
# Free-tier keys: Google may use content to improve its products. See docs/GEMINI-ASSESSMENT.md
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
# low | medium | high (3.8 Flash rejects "minimal"; thinking tokens are billed)
GEMINI_THINKING_LEVEL="low"
# Per call (all retries); each attempt also times out, since an overloaded model can hang
GEMINI_TIMEOUT_MS="180000"
GEMINI_ATTEMPT_TIMEOUT_MS="90000"
# Used while GEMINI_MODEL is unavailable (503 "high demand"/hangs); "" disables
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"
GEMINI_MAX_TOKENS="16384"

# zai = GLM served directly by Z.ai. Cloud: prompts incl. source excerpts go to Z.ai.
ZAI_API_KEY=""
GLM_AI_MODEL="glm-5.3-flash"
# Pay-as-you-go: https://api.z.ai/api/paas/v4 · GLM Coding Plan keys: https://api.z.ai/api/coding/paas/v4
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"
# low | high | max (GLM-5.3 always thinks; max is very slow for structured output)
ZAI_REASONING_EFFORT="low"
ZAI_TIMEOUT_MS="300000"
ZAI_ATTEMPT_TIMEOUT_MS="150000"
ZAI_MAX_TOKENS="16384"

# --- Embeddings ---------------------------------------------------------------
# mock | openai | ollama
#   mock   = deterministic hashed bag-of-words (lexical only, offline)
#   ollama = local Ollama /api/embed, e.g. embeddinggemma (semantic, multilingual)
# After changing provider/model run: npx tsx scripts/reembed.ts
EMBEDDINGS_PROVIDER="mock"
OLLAMA_EMBEDDINGS_MODEL="embeddinggemma"
# Optional retrieval floor (cosine); unset = calibrated per provider (scripts/calibrate-retrieval.ts)
# RETRIEVAL_MIN_SCORE="0.3"
EMBEDDINGS_MODEL="text-embedding-3-small"
EMBEDDINGS_DIMENSIONS="1536"

# --- Speech-to-text -----------------------------------------------------------
# mock | whisper | deepgram
# mock writes placeholder text and is refused unless ALLOW_MOCK_PROVIDERS="true" (demos) or in tests
TRANSCRIPTION_PROVIDER="mock"
ALLOW_MOCK_PROVIDERS="false"
# whisper = any OpenAI-compatible /v1/audio/transcriptions endpoint
WHISPER_BASE_URL="https://api.openai.com/v1"
WHISPER_API_KEY=""
WHISPER_MODEL="whisper-1"
# Local, offline alternative (GPU or CPU): a Speaches server with large-v3-turbo —
#   TRANSCRIPTION_PROVIDER="whisper"
#   WHISPER_BASE_URL="http://localhost:8000/v1"
#   WHISPER_MODEL="deepdml/faster-whisper-large-v3-turbo-ct2"
#   WHISPER_API_KEY=""   (not needed locally)
# One request per lecture: allow ~a quarter of the audio length on a GPU
WHISPER_TIMEOUT_MS="3600000"
DEEPGRAM_API_KEY=""

# --- GPU / CPU for local processing ---------------------------------------------
# The GPU is detected with nvidia-smi (hardware + driver) and shown in the top bar
# next to the AI model ("No GPU" otherwise). Without a GPU, Ollama and Speaches
# (WHISPER__INFERENCE_DEVICE=auto) run on the CPU and these timeouts are multiplied:
GPU_DETECTION="auto"   # auto | off (off = always treat as No GPU)
CPU_TIMEOUT_FACTOR="4"

# --- Translation and read-aloud (bilingual sources) -----------------------------
# French sources are translated to English at import; students switch FR / EN on
# the source page and have it read aloud. Models are chosen at /admin -> AI model:
# translator = local Gemma 4 (Ollama) or Azure AI Translator; read-aloud = local
# Kokoro / Piper (Speaches server below), Azure Neural TTS or Gemini TTS.
SPEACHES_BASE_URL="http://localhost:8000/v1"
GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts"
# Azure (optional). One Azure AI Services key works for both Speech and Translator.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="westeurope"
AZURE_TRANSLATOR_KEY=""
AZURE_TRANSLATOR_REGION="westeurope"
AZURE_TRANSLATOR_ENDPOINT="https://api.cognitive.microsofttranslator.com"
# The Azure portal names are accepted too (the AZURE_* values win when both are set):
#   AZ_API_KEY1=...                                     -> Speech and Translator key
#   AZ_VOICE_SYNTHESIS=https://eastus.tts.speech.microsoft.com  -> region "eastus"
#   AZ_API_TRANSLATE=https://api.cognitive.microsofttranslator.com/

# --- Text-to-speech (audio recap) ---------------------------------------------
# mock | openai
TTS_PROVIDER="mock"
TTS_MODEL="tts-1"
TTS_VOICE="alloy"

# --- YouTube import -------------------------------------------------------------
# Only needed to fetch metadata for pasted links; ingestion still requires the
# user's explicit consent confirmation in the UI.
YOUTUBE_API_KEY=""

# --- Whole-course generation ---------------------------------------------------
# Source passages (in tokens) a study guide / flashcards / quiz / exercises run may
# read: the whole course when it fits, else a sample spread over every source.
WHOLE_SET_TOKEN_BUDGET="60000"        # cloud models (Gemini, GLM)
WHOLE_SET_TOKEN_BUDGET_LOCAL="6000"   # local model (Gemma via Ollama)

# --- Rate limiting / feature flags ----------------------------------------------
GENERATION_RATE_LIMIT_PER_HOUR="30"
